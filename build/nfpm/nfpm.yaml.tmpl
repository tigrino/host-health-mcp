name: host-health-mcp
arch: "${ARCH}"
version: "${VERSION}"
section: admin
priority: optional
maintainer: Albert 'Tigr' Zenkoff <albert@tigr.net>
description: |
  Read-only Linux host health-check service. A network-facing daemon
  answers structured RPC queries about local host health over an
  mTLS HTTPS endpoint; a privileged helper service performs the few
  reads that require root. See /usr/share/doc/host-health-mcp/.
vendor: tigr.net
homepage: https://tigr.net/

depends:
  - adduser

contents:
  - src: ../dist/${ARCH}/host-health-mcp-daemon
    dst: /usr/local/sbin/host-health-mcp-daemon
    file_info:
      mode: 0755

  - src: ../dist/${ARCH}/host-health-mcp-helper
    dst: /usr/local/sbin/host-health-mcp-helper
    file_info:
      mode: 0755

  - src: ../systemd/host-health-mcp.service
    dst: /lib/systemd/system/host-health-mcp.service
    file_info:
      mode: 0644
  - src: ../systemd/host-health-mcp-helper.service
    dst: /lib/systemd/system/host-health-mcp-helper.service
    file_info:
      mode: 0644

  - src: ../postinst/caps-template.sh
    dst: /usr/local/share/host-health-mcp/caps-template.sh
    file_info:
      mode: 0755

  - src: ../examples/daemon.yml
    dst: /etc/host-health-mcp/daemon.yml.example
    type: config|noreplace
    file_info:
      mode: 0640
  - src: ../examples/helper.yml
    dst: /etc/host-health-mcp/helper.yml.example
    type: config|noreplace
    file_info:
      mode: 0640
  - src: ../examples/manifest.yml
    dst: /etc/host-health-mcp/manifest.yml.example
    type: config|noreplace
    file_info:
      mode: 0644

  - src: ../../doc/REQUIREMENTS.txt
    dst: /usr/share/doc/host-health-mcp/REQUIREMENTS.txt
    file_info:
      mode: 0644
  - src: ../../doc/design-overview.md
    dst: /usr/share/doc/host-health-mcp/design-overview.md
    file_info:
      mode: 0644
  - src: ../../doc/threat-model.md
    dst: /usr/share/doc/host-health-mcp/threat-model.md
    file_info:
      mode: 0644
  - src: ../../doc/schema-draft.yaml
    dst: /usr/share/doc/host-health-mcp/schema.yaml
    file_info:
      mode: 0644
  - src: ../../doc/version-matrix.md
    dst: /usr/share/doc/host-health-mcp/version-matrix.md
    file_info:
      mode: 0644

scripts:
  postinstall: ../postinst/postinst.sh
