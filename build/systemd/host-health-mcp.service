[Unit]
Description=host-health-mcp network-facing daemon
Documentation=file:///usr/share/doc/host-health-mcp-server/design-overview.md
After=network.target host-health-mcp-helper.service
Requires=host-health-mcp-helper.service

[Service]
Type=notify
ExecStart=/usr/sbin/host-health-mcp-daemon --config /etc/host-health-mcp/daemon.yml
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStopSec=10s

User=host-health-mcp
Group=host-health-mcp
NoNewPrivileges=yes

# AF_NETLINK is REQUIRED, not an oversight. The network tool reads
# per-interface addresses via net.Interface.Addrs(), which Go
# implements over netlink RTM_GETADDR — see readInterfaceAddrs in
# tools/network. Omitting it does not fail loudly: the call returns
# "address family not supported by protocol", the tool swallows it, and
# every interface reports addrs: [] with status ok and no warning. A
# silent data regression on every host, which is exactly the shape of
# defect this hardening pass exists to remove.
#
# AF_PACKET stays out — nothing in the daemon opens a raw socket, and
# it is the family a compromised listener would reach for to capture
# from the wire.
#
# ProcSubset=pid is deliberately NOT set either: it hides
# /proc/meminfo, /proc/pressure, /proc/net/* and /proc/vmstat, which
# would break the system, pressure, sockets and kernel tools outright.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# Tripwire: stdlib Go does not JIT; this line catches any future FFI/JIT code path that would attempt W^X violations.
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

StateDirectory=host-health-mcp
StateDirectoryMode=0750

ReadWritePaths=/var/lib/host-health-mcp
ReadOnlyPaths=/etc/host-health-mcp

# Two directives, not one line. A leading `~` makes the WHOLE value a
# deny-list; a `~` in the middle of a list is parsed as part of a
# syscall NAME. The single-line form here was therefore rejected group
# by group — "System call ~@privileged is not known, ignoring" — and
# only @system-service was ever applied. Every explicit denial below
# was silently inert.
#
# @system-service already excludes most of these, so restoring them
# should be a no-op in practice; they are kept because the intent is
# worth stating explicitly and the allow-set may widen upstream.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=host-health-mcp

[Install]
WantedBy=multi-user.target
