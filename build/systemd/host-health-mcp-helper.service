[Unit]
Description=host-health-mcp privileged helper
Documentation=file:///usr/share/doc/host-health-mcp/design-overview.md
After=local-fs.target
PartOf=host-health-mcp.service

[Service]
Type=notify
ExecStart=/usr/local/sbin/host-health-mcp-helper --config /etc/host-health-mcp/helper.yml
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStopSec=10s

User=root
Group=root
NoNewPrivileges=yes

# Capability sets are templated at install time from manifest.yml.
# The shipped base unit keeps only CAP_CHOWN in bounding so the helper
# can chown its unix socket and runtime directory at startup; ambient
# is empty here. The post-install scriptlet writes
# /etc/systemd/system/host-health-mcp-helper.service.d/caps.conf with
# the per-op cap union; that drop-in sets BOTH CapabilityBoundingSet=
# (CAP_CHOWN + per-op caps) and AmbientCapabilities= (per-op caps
# only, no CAP_CHOWN). The ambient half matters because modern tools
# (auditctl, etc.) introspect their effective set rather than fall
# back on euid==0; under NoNewPrivileges=yes the kernel needs the
# per-op cap in ambient to surface it as effective after execve.
# Design 7 cap-templating.
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

RuntimeDirectory=host-health-mcp
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no

ReadWritePaths=/run/host-health-mcp

SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=host-health-mcp-helper

[Install]
WantedBy=multi-user.target
