# host-health-mcp-client - example environment
#
# The client is configured entirely by environment variable; it has no
# configuration file and no command-line flags beyond --version. Load
# this file from the MCP host's plugin launcher, or source it:
#
#   set -a; . /etc/host-health-mcp/client.env; set +a
#   host-health-mcp-client
#
# Copy it out of /usr/share/doc/host-health-mcp-client/examples/ before
# editing; the packaged copy is documentation and is replaced on upgrade.

# --- Target ----------------------------------------------------------

# Default host for tool calls that omit the "host" argument. Leave empty
# to require every call to name its target explicitly; the client then
# refuses a call with no host rather than guessing.
HOSTHEALTH_TARGET_HOST=health-probe.example.com

# Daemon listener port. Default 8443 when unset.
HOSTHEALTH_TARGET_PORT=8443

# Appended to short host names supplied in a tool call, so callers can
# say "web01" instead of "web01.example.com". Empty means names are
# used exactly as given.
HOSTHEALTH_DNS_SUFFIX=example.com

# --- mTLS ------------------------------------------------------------
#
# All three are the operator's own PKI. The daemon requires a client
# certificate carrying extendedKeyUsage = clientAuth (1.12.0 onward).

# Client certificate and key. These are the defaults; set them only if
# the material lives elsewhere.
HOSTHEALTH_TLS_CERT=/etc/host-health-mcp/plugin/cert.pem
HOSTHEALTH_TLS_KEY=/etc/host-health-mcp/plugin/key.pem

# CA bundle used to verify the DAEMON's certificate. There is no
# default: the client refuses to start when this is empty rather than
# falling back to the system root store, where any publicly trusted CA
# could issue a certificate the client would accept.
HOSTHEALTH_TLS_CA=/etc/host-health-mcp/plugin/ca.pem

# Escape hatch for a one-off test against a host whose certificate is
# issued by a public CA. Set to 1 to use the system root store instead
# of HOSTHEALTH_TLS_CA. The client logs a warning at startup whenever
# this is active. Leave unset in normal operation.
#HOSTHEALTH_TRUST_SYSTEM_ROOTS=1

# --- MCP surface -----------------------------------------------------

# Prefix applied to every tool name the client registers, so the
# daemon's tools do not collide with other MCP servers loaded by the
# same host. Default "host_", giving host_system, host_logs, and so on.
HOSTHEALTH_TOOL_PREFIX=host_
